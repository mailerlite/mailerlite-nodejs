e="presentation" cellpadding="0" cellspacing="0" border="0" align="center"><tbody><tr><td class="py-6 px-4" style="padding-left: 16px; padding-right: 16px; padding-top: 24px; padding-bottom: 24px;"><!--[--><!--[--><table role="presentation" cellpadding="0" cellspacing="0" border="0" width="100%" class="ml-email-text-table ml-inline-email-node w-full" style="width: 100%;"><tbody><tr><td dir="ltr" style="padding-top: 12px;"><p dir="ltr" class="ml-p ml-p-1" style="margin-top: 0; font-family: \'Inter\', sans-serif, \'Arial\', \'Helvetica\', sans-serif; font-weight: 400; line-height: 150%; letter-spacing: 0px; font-size: 16px; color: #333333; margin-bottom: 4px; text-align: left;"></p></td></tr></tbody></table><!--]--><!--[--><table role="presentation" cellpadding="0" cellspacing="0" border="0" width="100%" class="w-full ml-email-divider-table ml-inline-email-node" style="width: 100%;"><tbody><tr><td align="center" style="padding-top: 12px;"><table role="presentation" cellpadding="0" cellspacing="0" border="0" width="100%"><tbody><tr><td height="1" style="padding-top: 12px; border-top: 1px solid #15C7D2; line-height: 0; font-size: 0;"></td></tr></tbody></table></td></tr></tbody></table><!--]--><!--[--><!----><!--]--><!--[--><table role="presentation" cellpadding="0" cellspacing="0" border="0" width="100%" class="ml-email-text-table ml-inline-email-node w-full" style="width: 100%;"><tbody><tr><td dir="ltr" style="padding-top: 12px;"><p dir="ltr" class="ml-p ml-p-1" style="margin-top: 0; font-family: \'Inter\', sans-serif, \'Arial\', \'Helvetica\', sans-serif; font-weight: 400; line-height: 150%; letter-spacing: 0px; font-size: 16px; color: #333333; margin-bottom: 4px; text-align: left;"><strong>Design squad</strong><br>Add your company postal address here</p></td></tr></tbody></table><!--]--><!--[--><!----><!--]--><!--[--><table role="presentation" cellpadding="0" cellspacing="0" border="0" width="100%" class="ml-email-text-table ml-inline-email-node w-full" style="width: